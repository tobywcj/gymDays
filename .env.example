# Copy to .env (gitignored) and fill in real values.
# Single source of truth for all services (Supabase CLI, scripts, Python AI service).
# The Next.js app duplicates the relevant subset in web/.env.local.

# ── Database (for migrations + scripts) ──
# From Supabase dashboard → Project Settings → Database → Connection string → URI.
# Single-quote the whole line to prevent shell expansion of $ in passwords.
SUPABASE_DB_URL='postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-X-REGION.pooler.supabase.com:5432/postgres'

# ── Project metadata ──
SUPABASE_PROJECT_REF='YOUR-PROJECT-REF'
SUPABASE_URL='https://YOUR-PROJECT-REF.supabase.co'

# ── API keys (Project Settings → API) ──
SUPABASE_ANON_KEY='eyJ...'
SUPABASE_SERVICE_ROLE_KEY='eyJ...'   # server-only, BYPASSES RLS — never expose to browser

# ── AI service ───────────────────────────────────────────────────────────────
# The agent "brain" defaults to Google's FREE Gemma (via the Gemini API). Get a
# free key (no card) at https://aistudio.google.com/apikey — this powers the app
# at zero cost out of the box. GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY='AIza...'
# Optional premium brains — bring your own key; selectable on demand in the
# header model dropdown once set. Embeddings always use OpenAI (no Anthropic
# equivalent), so OPENAI_API_KEY is still required for per-client memory search.
OPENAI_API_KEY='sk-...'
ANTHROPIC_API_KEY='sk-ant-...'

# Pick which LLM the agents use. Supported (litellm format):
#   gemini/gemma-4-31b-it                        ← FREE default (Gemma 4)
#   openai/gpt-4o-mini                           ← cheap, fast
#   openai/gpt-4o
#   openai/gpt-4.1-mini
#   anthropic/claude-haiku-4-5-20251001          ← cheap, fast
#   anthropic/claude-sonnet-5                    ← recommended balance
#   anthropic/claude-opus-5                      ← highest quality
# Default: gemini/gemma-4-31b-it if GEMINI_API_KEY is set; else anthropic (Haiku)
#          if that key is set; else openai/gpt-4o-mini.
# LLM_MODEL='gemini/gemma-4-31b-it'

# EMBED_MODEL='text-embedding-3-small'

# ── Strava ───────────────────────────────────────────────────────────────────
# Create an app at https://www.strava.com/settings/api. Leave blank to use
# the dev-seed UI button for local testing without a real Strava developer app.
STRAVA_CLIENT_ID=''
STRAVA_CLIENT_SECRET=''
# Your own random string. It must match the token you give Strava when creating
# the webhook subscription. No default — an unset value rejects the handshake.
STRAVA_VERIFY_TOKEN=''

# ── Internal / scheduled calls ───────────────────────────────────────────────
# Shared secret for pg_cron -> Next.js (x-cron-secret) and route-to-route
# fan-out (x-internal-secret). REQUIRED: with this unset, the scheduled-agent
# dispatch and Strava sync endpoints reject every call rather than falling back
# to a default. Generate one with `openssl rand -hex 32`, then store the same
# value in the DB so cron sends it:
#   update app_config set value = '<secret>' where key = 'cron_secret';
CRON_SECRET=''

# Password used by web/scripts/seed-test-users.mjs and the Playwright suite for
# the test-trainer fixtures. Only needed to run the E2E tests.
SEED_TEST_PASSWORD=''

# ── Messaging providers ───────────────────────────────────────────────────────
# Default is 'console' (logs to stderr, writes a messages row). Switch by
# setting MESSAGING_PROVIDER to one of: console, telegram, email.
# Per-trainer credentials can also be set in the UI at /connections (preferred).
# MESSAGING_PROVIDER='telegram'

# Telegram — free + official. Create a bot with @BotFather, paste the token.
# The telegram-bridge/ service uses this for inbound long-polling.
# https://core.telegram.org/bots#how-do-i-create-a-bot
TELEGRAM_BOT_TOKEN=''

# Email (Resend / Postmark / etc — bring your own transactional sender)
EMAIL_API_KEY=''
EMAIL_FROM='Gym Days <coach@gymdays.app>'
