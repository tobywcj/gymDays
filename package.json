{
  "name": "gymdays-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Tooling root for gymDays — Supabase CLI and shared scripts.",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supabase": "^2.100.0"
  },
  "scripts": {
    "db:push": "bash scripts/db-push.sh",
    "db:check": "/Users/toby/anaconda3/envs/gymDays/bin/python scripts/check-schema.py",
    "db:reset:local": "supabase/run-tests.sh",
    "test:sql": "bash supabase/run-tests.sh --cloud",
    "test:ai": "/Users/toby/anaconda3/envs/gymDays/bin/python -m pytest -c ai/pytest.ini --rootdir=. ai/tests",
    "test:web": "cd web && PATH=/Users/toby/anaconda3/envs/gymDays/bin:$PATH npx playwright test",
    "db:link": "supabase link",
    "seed:demo": "cd web && node scripts/seed-demo.mjs",
    "showcase": "bash scripts/capture-showcase.sh"
  }
}
