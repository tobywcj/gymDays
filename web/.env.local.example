# Copy to web/.env.local and fill in values from Supabase dashboard → Project Settings → API.
# .env.local is gitignored.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# Server-only — never expose to the browser. Used by Next.js server actions / route handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Python AI service URL (where /flows/onboarding is hosted).
AI_SERVICE_URL=http://localhost:8001

# ── Strava ─────────────────────────────────────────────────────────────────
# Public — browser uses it to build the authorize URL (safe to expose).
NEXT_PUBLIC_STRAVA_CLIENT_ID=
# Server-only — used by /api/strava/callback for the code-for-token exchange.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Your own random string, matching the Strava webhook subscription. No default
# — an unset value rejects the verification handshake.
STRAVA_VERIFY_TOKEN=

# ── Internal / scheduled calls ───────────────────────────────────────────────
# Shared secret for pg_cron -> Next.js (x-cron-secret) and route-to-route
# fan-out (x-internal-secret). REQUIRED: unset means the scheduled-agent
# dispatch and Strava sync endpoints reject every call. `openssl rand -hex 32`,
# then mirror it into the DB:
#   update app_config set value = '<secret>' where key = 'cron_secret';
CRON_SECRET=

# ── Image generation (optional) ──────────────────────────────────────────────
# Cloudflare Workers AI — Account ID + token (Account · Workers AI · Read).
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Hugging Face read token — huggingface.co/settings/tokens
HF_TOKEN=
